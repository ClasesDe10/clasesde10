# ═══════════════════════════════════════════════════════
# ClasesDe10 — Variables de entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas .env a Git — está en .gitignore
# ═══════════════════════════════════════════════════════

# ── SUPABASE ─────────────────────────────────────────
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhb...TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhb...TU_SERVICE_ROLE_KEY  # Solo backend/Edge Functions
NOTIFICATION_SECRET=pon_aqui_un_valor_largo_y_aleatorio

# ── GOOGLE MAPS ROUTES (solo servidor; OAuth del worker por defecto) ──
# Opcional si el worker usa la cuenta de servicio de Firebase mediante OAuth.
# Requiere facturacion vinculada y Routes API activa en el proyecto de Google Cloud.
GOOGLE_MAPS_ROUTES_API_KEY=

# ── ANALYTICS ────────────────────────────────────────
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GTM_ID=GTM-XXXXXXX
META_PIXEL_ID=XXXXXXXXXXXXXXXX
CLARITY_ID=XXXXXXXXXX

# ── EMAIL (Resend) ────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=noreply@clasesde10.com
EMAIL_REPLY_TO=contacto.clasesde10@gmail.com

# ── DOMINIO ───────────────────────────────────────────
SITE_URL=https://clasesde10.com
