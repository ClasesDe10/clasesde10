    function validChatCreate(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/asignaciones/$(chatId))
        && request.resource.data.keys().hasOnly([
          'assignmentId',
          'asignacion_id',
          'familyUid',
          'familia_id',
          'teacherUid',
          'profesor_id',
