          || (
            request.resource.data.attendanceStatus == 'confirmada_por_ambas_partes'
            && request.resource.data.lifecycleStatus == 'pendiente_pago'
          )
          || (
            request.resource.data.attendanceStatus == 'pendiente_profesor'
            && request.resource.data.lifecycleStatus == 'pendiente_confirmacion'
          )
          || (
            request.resource.data.attendanceStatus == 'incidencia'
            && request.resource.data.lifecycleStatus == 'incidencia'
          )
        );
    }

    function validClassIncidentCreate() {
