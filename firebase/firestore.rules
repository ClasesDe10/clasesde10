rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserProfile(uid) {
      return exists(userDoc(uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return signedIn()
        && hasUserProfile(request.auth.uid)
        && get(userDoc(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function validPublicLead() {
      return request.resource.data.keys().hasOnly([
          'tipo',
          'nombre',
          'email',
          'telefono',
          'perfil',
          'asunto',
          'mensaje',
          'metadata',
          'estado',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'tipo',
          'nombre',
          'email',
          'metadata',
          'estado',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.tipo in ['contacto', 'familia', 'profesor']
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 160
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && (!request.resource.data.keys().hasAny(['telefono'])
          || request.resource.data.telefono == null
          || (request.resource.data.telefono is string && request.resource.data.telefono.size() <= 40))
        && (!request.resource.data.keys().hasAny(['perfil'])
          || request.resource.data.perfil == null
          || (request.resource.data.perfil is string && request.resource.data.perfil.size() <= 80))
        && (!request.resource.data.keys().hasAny(['asunto'])
          || request.resource.data.asunto == null
          || (request.resource.data.asunto is string && request.resource.data.asunto.size() <= 180))
        && (!request.resource.data.keys().hasAny(['mensaje'])
          || request.resource.data.mensaje == null
          || (request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 3000))
        && validPublicLeadMetadata();
    }

    function optionalMetadataString(field, maxSize) {
      return !request.resource.data.metadata.keys().hasAny([field])
        || request.resource.data.metadata[field] == null
        || (
          request.resource.data.metadata[field] is string
          && request.resource.data.metadata[field].size() <= maxSize
        );
    }

    function requiredString(field, minSize, maxSize) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= minSize
        && request.resource.data[field].size() <= maxSize;
    }

    function optionalString(field, maxSize) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] == null
        || (
          request.resource.data[field] is string
          && request.resource.data[field].size() <= maxSize
        );
    }

    function validClientTimestampsOnCreate() {
      return request.resource.data.createdAt == request.time
        && (
          !request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time
        );
    }

    function validClientUpdatedAt() {
      return request.resource.data.updatedAt == request.time;
    }

    function validAuditLogCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'action',
          'module',
          'entityType',
          'entityId',
          'actorUid',
          'actorEmail',
          'actorRole',
          'actorType',
          'responsibleUid',
          'responsibleEmail',
          'origin',
          'source',
          'severity',
          'description',
          'before',
          'after',
          'changes',
          'metadata',
          'context',
          'error',
          'trace',
          'createdAt',
          'created_at'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion',
          'action',
          'module',
          'entityType',
          'entityId',
          'actorUid',
          'origin',
          'source',
          'severity',
          'description',
          'createdAt'
        ])
        && request.resource.data.schemaVersion == 'audit_log_v1'
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.action is string
        && request.resource.data.action.size() >= 3
        && request.resource.data.action.size() <= 140
        && request.resource.data.module is string
        && request.resource.data.module.size() <= 80
        && request.resource.data.entityType is string
        && request.resource.data.entityType.size() <= 80
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() <= 180
        && request.resource.data.origin is string
        && request.resource.data.origin.size() <= 80
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 180
        && request.resource.data.severity is string
        && request.resource.data.severity in ['info', 'warning', 'high', 'critical', 'error', 'success']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && (!request.resource.data.keys().hasAny(['actorEmail']) || request.resource.data.actorEmail is string)
        && (!request.resource.data.keys().hasAny(['actorRole']) || request.resource.data.actorRole is string)
        && (!request.resource.data.keys().hasAny(['actorType']) || request.resource.data.actorType is string)
        && (!request.resource.data.keys().hasAny(['responsibleUid']) || request.resource.data.responsibleUid is string)
        && (!request.resource.data.keys().hasAny(['responsibleEmail']) || request.resource.data.responsibleEmail is string)
        && (!request.resource.data.keys().hasAny(['before']) || request.resource.data.before == null || request.resource.data.before is map)
        && (!request.resource.data.keys().hasAny(['after']) || request.resource.data.after == null || request.resource.data.after is map)
        && (!request.resource.data.keys().hasAny(['changes']) || request.resource.data.changes is list)
        && (!request.resource.data.keys().hasAny(['metadata']) || request.resource.data.metadata is map)
        && (!request.resource.data.keys().hasAny(['context']) || request.resource.data.context is map)
        && (!request.resource.data.keys().hasAny(['error']) || request.resource.data.error == null || request.resource.data.error is map);
    }

    function optionalAnalyticsString(field, maxSize) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] == null
        || (
          request.resource.data[field] is string
          && request.resource.data[field].size() <= maxSize
        );
    }

    function optionalAnalyticsNumber(field) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] == null
        || request.resource.data[field] is int
        || request.resource.data[field] is float;
    }

    function validAnalyticsEventCreate() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'analyticsVersion',
          'eventName',
          'eventType',
          'category',
          'feature',
          'actorUid',
          'actorRole',
          'anonymousId',
          'sessionId',
          'entityType',
          'entityId',
          'experimentId',
          'experimentKey',
          'variant',
          'pagePath',
          'pageUrl',
          'referrer',
          'userAgent',
          'language',
          'timezone',
          'viewport',
          'source',
          'severity',
          'durationMs',
          'value',
          'metadata',
          'context',
          'day',
          'month',
          'createdAt',
          'created_at'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion',
          'analyticsVersion',
          'eventName',
          'eventType',
          'category',
          'feature',
          'anonymousId',
          'sessionId',
          'pagePath',
          'source',
          'severity',
          'metadata',
          'context',
          'day',
          'month',
          'createdAt'
        ])
        && request.resource.data.schemaVersion == 'analytics_event_v1'
        && request.resource.data.createdAt == request.time
        && request.resource.data.eventName is string
        && request.resource.data.eventName.size() >= 3
        && request.resource.data.eventName.size() <= 120
        && request.resource.data.eventName.matches('^[a-z0-9_.:-]+$')
        && request.resource.data.analyticsVersion is string
        && request.resource.data.analyticsVersion.size() <= 100
        && request.resource.data.eventType is string
        && request.resource.data.eventType.size() <= 80
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.feature is string
        && request.resource.data.feature.size() <= 120
        && request.resource.data.anonymousId is string
        && request.resource.data.anonymousId.size() <= 180
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 220
        && request.resource.data.pagePath is string
        && request.resource.data.pagePath.size() <= 240
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 80
        && request.resource.data.severity in ['info', 'success', 'warning', 'high', 'critical', 'error']
        && request.resource.data.metadata is map
        && request.resource.data.metadata.keys().size() <= 36
        && request.resource.data.context is map
        && request.resource.data.context.keys().size() <= 28
        && request.resource.data.day is string
        && request.resource.data.day.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.month is string
        && request.resource.data.month.matches('^\\d{4}-\\d{2}$')
        && optionalAnalyticsString('actorUid', 180)
        && (
          !request.resource.data.keys().hasAny(['actorUid'])
          || request.resource.data.actorUid == ''
          || (signedIn() && request.resource.data.actorUid == request.auth.uid)
        )
        && optionalAnalyticsString('actorRole', 80)
        && optionalAnalyticsString('entityType', 80)
        && optionalAnalyticsString('entityId', 180)
        && optionalAnalyticsString('experimentId', 180)
        && optionalAnalyticsString('experimentKey', 120)
        && optionalAnalyticsString('variant', 80)
        && optionalAnalyticsString('pageUrl', 500)
        && optionalAnalyticsString('referrer', 500)
        && optionalAnalyticsString('userAgent', 500)
        && optionalAnalyticsString('language', 40)
        && optionalAnalyticsString('timezone', 80)
        && optionalAnalyticsString('created_at', 40)
        && optionalAnalyticsNumber('durationMs')
        && optionalAnalyticsNumber('value')
        && (!request.resource.data.keys().hasAny(['viewport']) || request.resource.data.viewport is map);
    }

    function validPublicLeadMetadata() {
      return request.resource.data.metadata is map
          && request.resource.data.metadata.keys().hasOnly([
            'alumno',
            'anios',
            'canal',
            'consent_privacy',
            'disponibilidad',
            'frecuencia',
            'inicio',
            'materia',
            'materias',
            'modalidad',
            'nivel',
            'niveles',
            'objetivo',
            'origen',
            'page_path',
            'page_url',
            'presupuesto',
            'referrer',
            'user_agent',
            'utm_campaign',
            'utm_content',
            'utm_medium',
            'utm_source',
            'utm_term',
            'verificacion',
            'zona'
          ])
          && request.resource.data.metadata.keys().hasAll(['consent_privacy'])
          && optionalMetadataString('alumno', 160)
          && optionalMetadataString('anios', 80)
          && optionalMetadataString('canal', 80)
          && optionalMetadataString('disponibilidad', 300)
          && optionalMetadataString('frecuencia', 120)
          && optionalMetadataString('inicio', 120)
          && optionalMetadataString('materia', 180)
          && optionalMetadataString('materias', 180)
          && optionalMetadataString('modalidad', 120)
          && optionalMetadataString('nivel', 120)
          && optionalMetadataString('niveles', 120)
          && optionalMetadataString('objetivo', 160)
          && optionalMetadataString('origen', 80)
          && optionalMetadataString('page_path', 300)
          && optionalMetadataString('page_url', 500)
          && optionalMetadataString('presupuesto', 120)
          && optionalMetadataString('referrer', 500)
          && optionalMetadataString('user_agent', 500)
          && optionalMetadataString('utm_campaign', 160)
          && optionalMetadataString('utm_content', 160)
          && optionalMetadataString('utm_medium', 160)
          && optionalMetadataString('utm_source', 160)
          && optionalMetadataString('utm_term', 160)
          && optionalMetadataString('verificacion', 180)
          && optionalMetadataString('zona', 180)
          && request.resource.data.metadata.consent_privacy == true;
    }

    function validUserCreate(uid) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'email',
          'nombre',
          'apellidos',
          'telefono',
          'role',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['email', 'nombre', 'role', 'active', 'createdAt'])
        && request.resource.data.role in ['familia', 'profesor', 'alumno']
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        && requiredString('email', 3, 254)
        && requiredString('nombre', 1, 80)
        && optionalString('apellidos', 120)
        && optionalString('telefono', 40)
        && validClientTimestampsOnCreate();
    }

    function validUserSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'apellidos',
          'telefono',
          'updatedAt'
        ])
        && requiredString('nombre', 1, 80)
        && optionalString('apellidos', 120)
        && optionalString('telefono', 40)
        && validClientUpdatedAt()
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active;
    }

    function validRoleProfileCreate(uid, role) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'userUid',
          'email',
          'nombre',
          'apellidos',
          'telefono',
          'active',
          'status',
          'perfil_completo',
          'profileComplete',
          'estado_verificacion',
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'userUid',
          'email',
          'nombre',
          'active',
          'status',
          'createdAt'
        ])
        && request.resource.data.userUid == uid
        && request.resource.data.email == request.auth.token.email
        && requiredString('email', 3, 254)
        && requiredString('nombre', 1, 80)
        && optionalString('apellidos', 120)
        && optionalString('telefono', 40)
        && request.resource.data.active is bool
        && request.resource.data.status in (
          role == 'profesor'
            ? ['pendiente_revision', 'pendiente_perfil']
            : ['activo']
        )
        && (!request.resource.data.keys().hasAny(['perfil_completo'])
          || request.resource.data.perfil_completo == false)
        && (!request.resource.data.keys().hasAny(['profileComplete'])
          || request.resource.data.profileComplete == false)
        && (!request.resource.data.keys().hasAny(['estado_verificacion'])
          || request.resource.data.estado_verificacion in ['pendiente', 'pendiente_perfil'])
        && (!request.resource.data.keys().hasAny(['verificationStatus'])
          || request.resource.data.verificationStatus in ['pendiente', 'pendiente_perfil'])
        && validClientTimestampsOnCreate();
    }

    function validRoleProfileSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'apellidos',
          'telefono',
          'userUid',
          'email',
          'direccion',
          'address',
          'ciudad',
          'city',
          'codigo_postal',
          'postalCode',
          'zona',
          'zone',
          'contacto_preferido',
          'preferredContact',
          'contacto_emergencia_nombre',
          'emergencyContactName',
          'contacto_emergencia_telefono',
          'emergencyContactPhone',
          'idiomas',
          'languages',
          'notas_perfil',
          'profileNotes',
          'perfil_completo',
          'profileComplete',
          'profileCompletionPercent',
          'profileCompletion',
          'profileIssues',
          'updatedAt',
          'updated_at'
        ])
        && requiredString('nombre', 1, 80)
        && optionalString('apellidos', 120)
        && optionalString('telefono', 40)
        && optionalString('direccion', 240)
        && optionalString('address', 240)
        && optionalString('ciudad', 160)
        && optionalString('city', 160)
        && optionalString('codigo_postal', 20)
        && optionalString('postalCode', 20)
        && optionalString('zona', 160)
        && optionalString('zone', 160)
        && optionalString('contacto_preferido', 40)
        && optionalString('preferredContact', 40)
        && optionalString('contacto_emergencia_nombre', 160)
        && optionalString('emergencyContactName', 160)
        && optionalString('contacto_emergencia_telefono', 40)
        && optionalString('emergencyContactPhone', 40)
        && optionalString('notas_perfil', 1200)
        && optionalString('profileNotes', 1200)
        && validClientUpdatedAt()
        && (
          request.resource.data.userUid == resource.data.userUid
          || (
            !resource.data.keys().hasAny(['userUid'])
            && request.resource.data.userUid == request.auth.uid
          )
        )
        && (
          request.resource.data.email == resource.data.email
          || (
            !resource.data.keys().hasAny(['email'])
            && request.resource.data.email == request.auth.token.email
          )
        )
        && request.resource.data.active == resource.data.active
        && request.resource.data.status == resource.data.status;
    }

    function validTeacherProfileSelfUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'nombre',
          'apellidos',
          'telefono',
          'foto_url',
          'photoUrl',
          'direccion',
          'address',
          'ciudad',
          'city',
          'codigo_postal',
          'postalCode',
          'zona',
          'zone',
          'nivel_estudios',
          'studyLevel',
          'estudio_exacto',
          'exactStudy',
          'centro_estudios',
          'studyCenter',
          'colegio_estudios',
          'nota_bachillerato',
          'bachilleratoGrade',
          'nota_media_universidad',
          'universityAverageGrade',
          'bio',
          'experiencia_anios',
          'experienceYears',
          'disponibilidad_resumen',
          'availabilitySummary',
          'materias',
          'subjects',
          'niveles_educativos',
          'levels',
          'especialidades',
          'specialties',
          'idiomas',
          'languages',
          'certificaciones',
          'certifications',
          'acepta_bizum',
          'hasBizum',
          'perfil_completo',
          'profileComplete',
          'profileCompletionPercent',
          'profileCompletion',
          'profileIssues',
          'estado_verificacion',
          'verificationStatus',
          'status',
          'updatedAt',
          'updated_at'
        ])
        && (
          request.resource.data.userUid == resource.data.userUid
          || (
            !resource.data.keys().hasAny(['userUid'])
            && request.resource.data.userUid == request.auth.uid
          )
        )
        && request.resource.data.email == resource.data.email
        && request.resource.data.active == resource.data.active
        && (!changed.hasAny(['estado_verificacion'])
          || request.resource.data.estado_verificacion in ['pendiente', 'pendiente_perfil'])
        && (!changed.hasAny(['verificationStatus'])
          || request.resource.data.verificationStatus in ['pendiente', 'pendiente_perfil'])
        && (!changed.hasAny(['status'])
          || request.resource.data.status in ['pendiente_revision', 'pendiente_perfil'])
        && validClientUpdatedAt();
    }

    function validFamilyStudentUpdate() {
      return isFamilyParticipant(resource.data)
        && request.resource.data.familyUid == resource.data.familyUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'apellidos',
          'curso',
          'nivel',
          'nivel_educativo',
          'colegio',
          'fecha_nacimiento',
          'materias',
          'materias_necesita',
          'objetivos',
          'disponibilidad',
          'activo',
          'active',
          'updatedAt',
          'updated_at'
        ]);
    }

    function validStudentSelfClaim() {
      return signedIn()
        && (!resource.data.keys().hasAny(['studentUid']) || resource.data.studentUid == null)
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentUid',
          'usuario_id',
          'updatedAt',
          'updated_at'
        ]);
    }

    function isFamilyParticipant(data) {
      return signedIn()
        && (
          data.familyUid == request.auth.uid
          || data.familia_id == request.auth.uid
          || (
            hasRole('familia')
            && data.keys().hasAny(['participantUids'])
            && data.participantUids[request.auth.uid] == true
          )
          || (
            data.keys().hasAny(['studentId'])
            && exists(/databases/$(database)/documents/alumnos/$(data.studentId))
            && get(/databases/$(database)/documents/alumnos/$(data.studentId)).data.familyUid == request.auth.uid
          )
          || (
            data.keys().hasAny(['alumno_id'])
            && exists(/databases/$(database)/documents/alumnos/$(data.alumno_id))
            && get(/databases/$(database)/documents/alumnos/$(data.alumno_id)).data.familyUid == request.auth.uid
          )
        );
    }

    function isTeacherParticipant(data) {
      return signedIn()
        && (
          data.teacherUid == request.auth.uid
          || data.profesor_id == request.auth.uid
          || (data.keys().hasAny(['teacherUids']) && data.teacherUids[request.auth.uid] == true)
          || (
            hasRole('profesor')
            && data.keys().hasAny(['participantUids'])
            && data.participantUids[request.auth.uid] == true
          )
        );
    }

    function isStudentParticipant(data) {
      return signedIn() && data.studentUid == request.auth.uid;
    }

    function isParticipant(data) {
      return isFamilyParticipant(data)
        || isTeacherParticipant(data)
        || isStudentParticipant(data);
    }

    function availabilityFamilyBelongsToAuth(familyUid) {
      return signedIn()
        && familyUid is string
        && (
          familyUid == request.auth.uid
          || (
            exists(/databases/$(database)/documents/familias/$(familyUid))
            && (
              get(/databases/$(database)/documents/familias/$(familyUid)).data.userUid == request.auth.uid
              || get(/databases/$(database)/documents/familias/$(familyUid)).data.usuario_id == request.auth.uid
            )
          )
        );
    }

    function availabilityTeacherBelongsToAuth(teacherUid) {
      return signedIn()
        && teacherUid is string
        && (
          teacherUid == request.auth.uid
          || (
            exists(/databases/$(database)/documents/profesores/$(teacherUid))
            && (
              get(/databases/$(database)/documents/profesores/$(teacherUid)).data.userUid == request.auth.uid
              || get(/databases/$(database)/documents/profesores/$(teacherUid)).data.usuario_id == request.auth.uid
            )
          )
        );
    }

    function availabilityStudentOwnedByFamily(studentId, familyUid) {
      return availabilityFamilyBelongsToAuth(familyUid)
        && studentId is string
        && familyUid is string
        && exists(/databases/$(database)/documents/alumnos/$(studentId))
        && (
          get(/databases/$(database)/documents/alumnos/$(studentId)).data.familyUid == familyUid
          || get(/databases/$(database)/documents/alumnos/$(studentId)).data.familia_id == familyUid
          || availabilityFamilyBelongsToAuth(get(/databases/$(database)/documents/alumnos/$(studentId)).data.familyUid)
          || availabilityFamilyBelongsToAuth(get(/databases/$(database)/documents/alumnos/$(studentId)).data.familia_id)
        );
    }

    function isTeacherAvailability(data) {
      return data.keys().hasAny(['teacherUid', 'profesor_id'])
        && (
          !data.keys().hasAll(['teacherUid', 'profesor_id'])
          || data.teacherUid == data.profesor_id
        )
        && !data.keys().hasAny(['familyUid', 'familia_id', 'studentId', 'alumno_id']);
    }

    function availabilityTeacherUid(data) {
      return data.keys().hasAny(['teacherUid']) ? data.teacherUid : data.profesor_id;
    }

    function availabilityFamilyUid(data) {
      return data.keys().hasAny(['familyUid']) ? data.familyUid : data.familia_id;
    }

    function availabilityStudentId(data) {
      return data.keys().hasAny(['studentId']) ? data.studentId : data.alumno_id;
    }

    function isStudentAvailability(data) {
      return data.keys().hasAny(['familyUid', 'familia_id'])
        && data.keys().hasAny(['studentId', 'alumno_id'])
        && (
          !data.keys().hasAll(['familyUid', 'familia_id'])
          || (data.familyUid is string && data.familia_id is string)
        )
        && (
          !data.keys().hasAll(['studentId', 'alumno_id'])
          || (data.studentId is string && data.alumno_id is string)
        )
        && !data.keys().hasAny(['teacherUid', 'profesor_id']);
    }

    function isAvailabilityOwner(data) {
      return signedIn()
        && (
          (
            isTeacherAvailability(data)
            && availabilityTeacherBelongsToAuth(availabilityTeacherUid(data))
          )
          || (
            isStudentAvailability(data)
            && availabilityStudentOwnedByFamily(availabilityStudentId(data), availabilityFamilyUid(data))
          )
        );
    }

    function canReadOwnStudentAvailabilityQuery(data) {
      return signedIn()
        && hasRole('familia')
        && (
          (data.keys().hasAny(['familyUid']) && data.familyUid == request.auth.uid)
          || (data.keys().hasAny(['familia_id']) && data.familia_id == request.auth.uid)
        );
    }

    function canReadStudentAvailabilityForSchedulingQuery(data) {
      return signedIn()
        && hasRole('profesor')
        && data.keys().hasAny(['studentId'])
        && data.studentId is string;
    }

    function canReadAvailability(data) {
      return isAdmin()
        || isAvailabilityOwner(data)
        || canReadOwnStudentAvailabilityQuery(data)
        || canReadStudentAvailabilityForSchedulingQuery(data)
        || (signedIn() && hasRole('familia') && isTeacherAvailability(data))
        || (signedIn() && hasRole('profesor') && isTeacherAvailability(data))
        || (signedIn() && hasRole('profesor') && isStudentAvailability(data));
    }

    function validAvailabilityFields(data) {
      return data.keys().hasOnly([
          'teacherUid',
          'profesor_id',
          'familyUid',
          'familia_id',
          'studentId',
          'alumno_id',
          'dia_semana',
          'hora_inicio',
          'hora_fin',
          'schemaVersion',
          'canonicalCollection',
          'createdAt',
          'created_at',
          'updatedAt',
          'updated_at'
        ])
        && data.keys().hasAll(['dia_semana', 'hora_inicio', 'hora_fin'])
        && data.dia_semana is int
        && data.dia_semana >= 0
        && data.dia_semana <= 6
        && data.hora_inicio is string
        && data.hora_inicio.matches('^\\d{2}:\\d{2}$')
        && data.hora_fin is string
        && data.hora_fin.matches('^\\d{2}:\\d{2}$')
        && (!data.keys().hasAny(['schemaVersion']) || data.schemaVersion is string)
        && (!data.keys().hasAny(['canonicalCollection']) || data.canonicalCollection == 'disponibilidad');
    }

    function validTeacherAvailabilityPayload(data) {
      return validAvailabilityFields(data)
        && isTeacherAvailability(data)
        && availabilityTeacherBelongsToAuth(availabilityTeacherUid(data));
    }

    function validStudentAvailabilityPayload(data) {
      return validAvailabilityFields(data)
        && isStudentAvailability(data)
        && availabilityStudentOwnedByFamily(availabilityStudentId(data), availabilityFamilyUid(data));
    }

    function validAvailabilityCreate(data) {
      return (
        (
          hasRole('profesor')
          && validTeacherAvailabilityPayload(data)
        )
        || (
          hasRole('familia')
          && validStudentAvailabilityPayload(data)
        )
      )
        && (!data.keys().hasAny(['createdAt']) || data.createdAt == request.time)
        && (!data.keys().hasAny(['created_at']) || data.created_at is string)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt == request.time)
        && (!data.keys().hasAny(['updated_at']) || data.updated_at is string);
    }

    function validAvailabilityUpdate() {
      return isAvailabilityOwner(resource.data)
        && (
          (
            isTeacherAvailability(resource.data)
            && validTeacherAvailabilityPayload(request.resource.data)
            && request.resource.data.teacherUid == resource.data.teacherUid
            && request.resource.data.profesor_id == resource.data.profesor_id
          )
          || (
            isStudentAvailability(resource.data)
            && validStudentAvailabilityPayload(request.resource.data)
            && availabilityFamilyUid(request.resource.data) == availabilityFamilyUid(resource.data)
            && availabilityStudentId(request.resource.data) == availabilityStudentId(resource.data)
          )
        )
        && (
          !resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == resource.data.createdAt
        )
        && (
          !resource.data.keys().hasAny(['created_at'])
          || request.resource.data.created_at == resource.data.created_at
        )
        && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time)
        && (!request.resource.data.keys().hasAny(['updated_at']) || request.resource.data.updated_at is string);
    }

    function validTeacherPayoutCreate() {
      return hasRole('profesor')
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.profesor_id == request.auth.uid
        && request.resource.data.paymentType == 'teacher_payout'
        && request.resource.data.tipo == 'pago_profesor'
        && request.resource.data.metodo == 'bizum'
        && request.resource.data.estado == 'solicitado'
        && request.resource.data.status == 'solicitado'
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 5000
        && request.resource.data.amount == request.resource.data.monto
        && request.resource.data.classIds is list
        && request.resource.data.classIds.size() > 0
        && request.resource.data.classIds.size() <= 40
        && request.resource.data.classCount == request.resource.data.classIds.size()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'tipo',
          'paymentType',
          'teacherUid',
          'profesor_id',
          'userUid',
          'requestedByUid',
          'monto',
          'amount',
          'metodo',
          'method',
          'gateway',
          'provider',
          'estado',
          'status',
          'concepto',
          'notas_profesor',
          'teacherNotes',
          'telefono_bizum',
          'classIds',
          'classCount',
          'reconciliationStatus',
          'verificationSource',
          'idempotencyKey',
          'dueAt',
          'due_at',
          'createdAt',
          'created_at',
          'updatedAt',
          'updated_at'
        ]);
    }

    function validFamilyPaymentCreate() {
      return hasRole('familia')
        && request.resource.data.familyUid == request.auth.uid
        && request.resource.data.familia_id == request.auth.uid
        && request.resource.data.paymentType == 'family_payment'
        && request.resource.data.tipo == 'pago_familia'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.status == 'pendiente'
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 10000
        && request.resource.data.amount == request.resource.data.monto
        && request.resource.data.metodo in ['bizum', 'transferencia', 'efectivo', 'card', 'stripe_bizum', 'redsys_bizum']
        && request.resource.data.method == request.resource.data.metodo
        && request.resource.data.gateway in ['manual', 'stripe', 'redsys', 'bank_import']
        && request.resource.data.provider == request.resource.data.gateway
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'tipo',
          'paymentType',
          'familia_id',
          'familyUid',
          'documento_id',
          'documentId',
          'monto',
          'amount',
          'metodo',
          'method',
          'gateway',
          'provider',
          'estado',
          'status',
          'referencia',
          'reference',
          'concepto',
          'notas_familia',
          'familyNotes',
          'classIds',
          'classCount',
          'reconciliationStatus',
          'verificationSource',
          'verified',
          'dueAt',
          'due_at',
          'idempotencyKey',
          'createdAt',
          'created_at',
          'updatedAt',
          'updated_at'
        ]);
    }

    function isChatParticipant(data) {
      return signedIn()
        && (
          data.familyUid == request.auth.uid
          || data.familia_id == request.auth.uid
          || data.teacherUid == request.auth.uid
          || data.profesor_id == request.auth.uid
          || (
            data.keys().hasAny(['participantUids'])
            && data.participantUids[request.auth.uid] == true
          )
        );
    }

    function chatFamilyUid(data) {
      return data.keys().hasAny(['familyUid']) ? data.familyUid : data.familia_id;
    }

    function chatTeacherUid(data) {
      return data.keys().hasAny(['teacherUid']) ? data.teacherUid : data.profesor_id;
    }

    function chatStudentId(data) {
      return data.keys().hasAny(['studentId']) ? data.studentId : data.alumno_id;
    }

    function isChatParticipantUid(data, uid) {
      return uid is string
        && (
          data.familyUid == uid
          || data.teacherUid == uid
          || data.familia_id == uid
          || data.profesor_id == uid
          || (
            data.keys().hasAny(['participantUids'])
            && data.participantUids[uid] == true
          )
        );
    }

    function validTeacherClassUpdate() {
      return isTeacherParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'status',
          'lifecycleStatus',
          'teacherConfirmationStatus',
          'teacherAttendanceStatus',
          'attendanceStatus',
          'incidentStatus',
          'notasProfesor',
