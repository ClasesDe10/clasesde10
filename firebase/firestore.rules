          'studentId',
          'alumno_id',
          'materia',
          'subject',
          'kind',
          'scheduleKind',
          'firstClassDate',
          'fecha',
          'hora_inicio',
          'hora_fin',
          'durationMinutes',
          'duracion_minutos',
          'modalidad',
          'notas',
          'recurrence',
          'recurrenceLabel',
          'status',
          'availabilityStatus',
          'availabilityValidation',
          'availabilityOverrideRequested',
          'availabilityOverrideConfirmed',
          'availabilityOverrideReason',
          'availabilityOverrideMessage',
          'source',
