    function validPaymentScheduleFields(data) {
      return signedIn()
        && data.keys().hasOnly([
          'id',
          'type',
          'status',
          'active',
          'ownerUid',
          'familyUid',
          'familia_id',
          'teacherUid',
          'profesor_id',
          'studentId',
          'alumno_id',
          'assignmentId',
          'asignacion_id',
          'frequency',
          'paymentFrequency',
          'frecuencia_pago',
          'recurrenceDays',
          'anchorDate',
          'paymentAnchorDate',
          'fecha_inicio_pago',
          'dayOfWeek',
          'paymentDay',
          'dia_semana_pago',
          'time',
          'paymentTime',
          'hora_pago',
          'graceHours',
          'grace_hours',
          'label',
          'notes',
          'source',
          'updatedAtIso',
          'createdAt',
          'created_at',
          'updatedAt',
          'updated_at'
        ])
        && data.type == 'weekly_family_teacher_payment'
        && data.status == 'active'
        && data.active is bool
        && data.ownerUid == request.auth.uid
        && data.familyUid is string
        && data.familia_id == data.familyUid
        && data.teacherUid is string
        && data.profesor_id == data.teacherUid
        && data.studentId is string
        && data.alumno_id == data.studentId
        && data.frequency in ['semanal', 'quincenal']
        && data.paymentFrequency == data.frequency
        && data.frecuencia_pago == data.frequency
        && data.recurrenceDays is number
        && (
          (data.frequency == 'semanal' && data.recurrenceDays == 7)
          || (data.frequency == 'quincenal' && data.recurrenceDays == 14)
        )
        && data.anchorDate is string
        && data.anchorDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.paymentAnchorDate == data.anchorDate
        && data.fecha_inicio_pago == data.anchorDate
        && data.dayOfWeek is number
        && data.dayOfWeek >= 1
        && data.dayOfWeek <= 7
        && data.paymentDay == data.dayOfWeek
        && data.dia_semana_pago == data.dayOfWeek
        && data.time is string
        && data.time.matches('^\\d{2}:\\d{2}$')
        && data.paymentTime == data.time
        && data.hora_pago == data.time
        && data.graceHours is number
        && data.graceHours >= 1
        && data.graceHours <= 168
        && data.grace_hours == data.graceHours
        && data.label is string
        && data.label.size() <= 120
        && data.notes is string
        && data.notes.size() <= 500
        && data.source == 'family_dashboard';
    }

    function validPaymentScheduleCreate() {
      return hasRole('familia')
        && validPaymentScheduleFields(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validPaymentScheduleUpdate() {
      return hasRole('familia')
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.created_at == resource.data.created_at
        && validPaymentScheduleFields(request.resource.data)
        && request.resource.data.updatedAt == request.time;
    }

    function isChatParticipant(data) {
      return signedIn()
        && (
          data.familyUid == request.auth.uid
          || data.familia_id == request.auth.uid
          || data.teacherUid == request.auth.uid
          || data.profesor_id == request.auth.uid
          || (
            data.keys().hasAny(['participantUids'])
            && data.participantUids[request.auth.uid] == true
          )
        );
    }

    function chatFamilyUid(data) {
      return data.keys().hasAny(['familyUid'])
        && data.familyUid is string
        && data.familyUid.size() > 0
        ? data.familyUid
        : data.familia_id;
    }

    function chatTeacherUid(data) {
      return data.keys().hasAny(['teacherUid'])
        && data.teacherUid is string
        && data.teacherUid.size() > 0
        ? data.teacherUid
        : data.profesor_id;
    }

    function chatStudentId(data) {
      return data.keys().hasAny(['studentId'])
        && data.studentId is string
        && data.studentId.size() > 0
        ? data.studentId
        : data.alumno_id;
    }

    function isChatParticipantUid(data, uid) {
      return uid is string
        && (
          data.familyUid == uid
          || data.teacherUid == uid
          || data.familia_id == uid
          || data.profesor_id == uid
          || (
            data.keys().hasAny(['participantUids'])
            && data.participantUids[uid] == true
          )
        );
