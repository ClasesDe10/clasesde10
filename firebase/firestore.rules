    function validClassCancelledNotificationCreate() {
      let classPath = /databases/$(database)/documents/clases/$(request.resource.data.payload.classId);
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'userUid',
          'usuario_id',
          'title',
          'titulo',
          'body',
          'cuerpo',
          'type',
          'category',
          'priority',
          'channels',
