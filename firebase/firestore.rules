          'modalidad',
          'notas',
          'status',
          'availabilityStatus',
          'availabilityValidation',
          'proposedByUid',
          'proposedByRole',
          'proposedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.assignmentId == chatId
        && request.resource.data.familyUid == get(/databases/$(database)/documents/chats/$(chatId)).data.familyUid
        && request.resource.data.teacherUid == get(/databases/$(database)/documents/chats/$(chatId)).data.teacherUid
        && request.resource.data.studentId == get(/databases/$(database)/documents/chats/$(chatId)).data.studentId
        && request.resource.data.status == 'propuesta'
        && request.resource.data.proposedByUid == request.auth.uid
        && request.resource.data.proposedByRole in ['familia', 'profesor', 'admin']
        && request.resource.data.fecha is string
        && request.resource.data.fecha.size() == 10
        && request.resource.data.hora_inicio is string
        && request.resource.data.hora_inicio.size() == 5
        && request.resource.data.hora_fin is string
        && request.resource.data.hora_fin.size() == 5
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes > 0
        && request.resource.data.durationMinutes <= 480
        && optionalString('materia', 180)
        && optionalString('modalidad', 40)
        && optionalString('notas', 300)
        && (!request.resource.data.keys().hasAny(['availabilityStatus']) || request.resource.data.availabilityStatus is string)
        && (!request.resource.data.keys().hasAny(['availabilityValidation']) || request.resource.data.availabilityValidation is map)
        && request.resource.data.proposedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function canRespondToScheduleProposal(proposalData) {
      return isAdmin()
        || (
          request.auth.uid != proposalData.proposedByUid
          && !(proposalData.proposedByRole == 'familia' && hasRole('familia'))
          && !(proposalData.proposedByRole == 'profesor' && hasRole('profesor'))
        );
    }

    function validClassScheduleProposalUpdate(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
        && resource.data.status == 'propuesta'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'classId',
          'respondedByUid',
          'respondedByRole',
          'respondedAt',
          'rejectionReason',
          'updatedAt'
        ])
        && request.resource.data.status in ['aceptada', 'rechazada', 'cancelada']
        && request.resource.data.respondedByUid == request.auth.uid
        && request.resource.data.respondedByRole in ['familia', 'profesor', 'admin']
        && (
          isAdmin()
          || request.resource.data.status == 'cancelada'
          || canRespondToScheduleProposal(resource.data)
        )
        && (!request.resource.data.keys().hasAny(['classId']) || request.resource.data.classId is string)
        && optionalString('rejectionReason', 300)
        && request.resource.data.respondedAt == request.time
        && request.resource.data.updatedAt == request.time;
