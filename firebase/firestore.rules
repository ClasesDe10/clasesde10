          'participantUids',
          'createdByUid',
          'createdByRole',
          'createdAt',
          'updatedAt',
          'updated_at'
        ])
        && request.resource.data.createdFrom == 'chat_schedule_proposal'
        && request.resource.data.estado == 'confirmada'
        && request.resource.data.status == 'confirmada'
        && request.resource.data.lifecycleStatus == 'clase_programada'
        && request.resource.data.attendanceStatus == 'pendiente'
        && request.resource.data.assignmentId == request.resource.data.asignacion_id
        && exists(chatPath)
        && exists(proposalPath)
        && isChatParticipant(get(chatPath).data)
