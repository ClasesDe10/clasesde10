      let chatPath = /databases/$(database)/documents/chats/$(request.resource.data.assignmentId);
      let proposalPath = /databases/$(database)/documents/chats/$(request.resource.data.assignmentId)/programaciones/$(request.resource.data.scheduleProposalId);
      return signedIn()
