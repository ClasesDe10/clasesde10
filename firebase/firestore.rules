    function validScheduleRecurrence(data) {
      return (
          !data.keys().hasAny(['recurrence'])
          && (!data.keys().hasAny(['recurrenceLabel']) || data.recurrenceLabel is string)
          && (!data.keys().hasAny(['kind']) || data.kind == 'one_off')
        )
        || (
          data.keys().hasAll(['kind', 'scheduleKind', 'recurrence', 'recurrenceLabel'])
          && data.kind == 'weekly_recurring'
          && data.scheduleKind == data.kind
          && data.recurrence is map
          && data.recurrence.keys().hasOnly([
            'frequency',
            'dayOfWeek',
            'startTime',
            'endTime',
            'timezone'
          ])
          && data.recurrence.frequency == 'weekly'
          && data.recurrence.dayOfWeek is int
          && data.recurrence.dayOfWeek >= 0
          && data.recurrence.dayOfWeek <= 6
          && data.recurrence.startTime == data.hora_inicio
          && data.recurrence.endTime == data.hora_fin
          && data.recurrence.timezone is string
          && data.recurrence.timezone.size() <= 80
          && data.recurrenceLabel is string
          && data.recurrenceLabel.size() <= 160
        );
    }

    function validClassScheduleProposalCreate(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
