    function canRespondToScheduleProposal(proposalData) {
      return isAdmin()
        || (
          request.auth.uid != proposalData.proposedByUid
          && !(proposalData.proposedByRole == 'familia' && hasRole('familia'))
          && !(proposalData.proposedByRole == 'profesor' && hasRole('profesor'))
        );
    }

    function validClassScheduleProposalUpdate(chatId) {
      return signedIn()
