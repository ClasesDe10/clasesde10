            && request.resource.data.isRecurring == true
            && request.resource.data.seriesIndex is number
            && request.resource.data.seriesIndex >= 0
            && request.resource.data.seriesIndex < 260
            && request.resource.data.seriesTotal is number
            && request.resource.data.seriesTotal >= 1
            && request.resource.data.seriesTotal <= 260
            && request.resource.data.seriesIndex < request.resource.data.seriesTotal
          )
        )
        && request.resource.data.teacherUid == chatTeacherUid(get(chatPath).data)
        && request.resource.data.profesor_id == chatTeacherUid(get(chatPath).data)
        && request.resource.data.familyUid == chatFamilyUid(get(chatPath).data)
        && request.resource.data.familia_id == chatFamilyUid(get(chatPath).data)
        && request.resource.data.studentId == chatStudentId(get(chatPath).data)
        && request.resource.data.alumno_id == chatStudentId(get(chatPath).data)
        && request.resource.data.participantUids[request.auth.uid] == true
        && request.resource.data.participantUids[request.resource.data.familyUid] == true
        && request.resource.data.participantUids[request.resource.data.teacherUid] == true
        && (
          (
            request.resource.data.fecha == get(proposalPath).data.fecha
            && request.resource.data.date == get(proposalPath).data.fecha
            && (
              !request.resource.data.keys().hasAny(['seriesIndex'])
              || request.resource.data.seriesIndex == 0
            )
          )
          || (
            get(proposalPath).data.scheduleKind == 'weekly_recurring'
            && request.resource.data.classSeriesId == request.resource.data.scheduleProposalId
            && request.resource.data.seriesId == request.resource.data.scheduleProposalId
            && request.resource.data.seriesStartDate == get(proposalPath).data.fecha
            && request.resource.data.seriesEndDate is string
            && request.resource.data.seriesEndDate.size() == 10
            && request.resource.data.seriesIndex is number
            && request.resource.data.seriesIndex >= 0
            && request.resource.data.seriesIndex < 260
            && request.resource.data.seriesTotal is number
            && request.resource.data.seriesTotal >= 1
            && request.resource.data.seriesTotal <= 260
            && request.resource.data.seriesIndex < request.resource.data.seriesTotal
            && request.resource.data.isRecurring == true
            && request.resource.data.recurrence is map
            && request.resource.data.recurrenceLabel == get(proposalPath).data.recurrenceLabel
            && request.resource.data.parentClassId is string
          )
        )
        && request.resource.data.hora_inicio == get(proposalPath).data.hora_inicio
        && request.resource.data.startTime == get(proposalPath).data.hora_inicio
        && request.resource.data.hora_fin == get(proposalPath).data.hora_fin
        && request.resource.data.endTime == get(proposalPath).data.hora_fin
        && request.resource.data.durationMinutes == get(proposalPath).data.durationMinutes
        && request.resource.data.duracion_minutos == get(proposalPath).data.durationMinutes
        && request.resource.data.scheduleProposalId is string
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByRole in ['familia', 'profesor', 'admin']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validChatAttachment() {
      return !request.resource.data.keys().hasAny(['attachment'])
        || (
          request.resource.data.attachment is map
          && request.resource.data.attachment.keys().hasOnly([
            'kind',
            'name',
            'mimeType',
            'sizeBytes',
            'storagePath',
            'durationMs'
          ])
          && request.resource.data.attachment.keys().hasAll([
            'kind',
            'name',
            'mimeType',
            'sizeBytes',
            'storagePath'
          ])
          && request.resource.data.attachment.kind in ['file', 'image', 'audio']
          && request.resource.data.attachment.name is string
          && request.resource.data.attachment.name.size() >= 1
          && request.resource.data.attachment.name.size() <= 180
          && request.resource.data.attachment.mimeType is string
          && request.resource.data.attachment.mimeType.matches(
            '^(image/(jpeg|jpg|png|webp|gif)|audio/(webm|ogg|mpeg|mp4|x-m4a|wav)|application/pdf|application/msword|application/vnd\\.ms-(excel|powerpoint)|application/vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet|presentationml\\.presentation)|text/plain)$'
          )
          && (
            request.resource.data.attachment.sizeBytes is int
            || request.resource.data.attachment.sizeBytes is float
          )
          && request.resource.data.attachment.sizeBytes > 0
          && request.resource.data.attachment.sizeBytes <= 10 * 1024 * 1024
          && request.resource.data.attachment.storagePath is string
          && request.resource.data.attachment.storagePath.size() >= 12
          && request.resource.data.attachment.storagePath.size() <= 600
          && request.resource.data.attachment.storagePath.matches('^chats/[^/]+/.+')
          && (
            !request.resource.data.attachment.keys().hasAny(['durationMs'])
            || request.resource.data.attachment.durationMs is int
            || request.resource.data.attachment.durationMs is float
          )
        );
    }

    function validChatMessageCreate() {
      return request.resource.data.keys().hasOnly([
          'senderUid',
          'senderRole',
          'senderName',
          'body',
          'messageType',
          'callId',
          'attachment',
          'replyTo',
          'createdAt',
          'readBy',
          'callKind'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole in ['familia', 'profesor', 'admin']
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && (
          !request.resource.data.keys().hasAny(['messageType'])
          || request.resource.data.messageType in ['text', 'file', 'image', 'audio', 'call']
        )
        && (
          !request.resource.data.keys().hasAny(['callId'])
          || (
            request.resource.data.messageType == 'call'
            && request.resource.data.callId is string
            && request.resource.data.callId.size() >= 6
            && request.resource.data.callId.size() <= 180
          )
        )
        && (
          !request.resource.data.keys().hasAny(['callKind'])
          || (
            request.resource.data.messageType == 'call'
            && request.resource.data.callKind in ['voice', 'video']
          )
        )
        && (
          !request.resource.data.keys().hasAny(['replyTo'])
          || (
            request.resource.data.replyTo is map
            && request.resource.data.replyTo.keys().hasOnly([
              'messageId',
              'senderUid',
              'senderName',
              'bodyPreview',
              'messageType'
            ])
            && request.resource.data.replyTo.messageId is string
            && request.resource.data.replyTo.messageId.size() >= 1
            && request.resource.data.replyTo.messageId.size() <= 180
            && request.resource.data.replyTo.senderUid is string
            && request.resource.data.replyTo.senderUid.size() <= 180
            && request.resource.data.replyTo.senderName is string
            && request.resource.data.replyTo.senderName.size() >= 1
            && request.resource.data.replyTo.senderName.size() <= 160
            && request.resource.data.replyTo.bodyPreview is string
            && request.resource.data.replyTo.bodyPreview.size() >= 1
            && request.resource.data.replyTo.bodyPreview.size() <= 240
            && request.resource.data.replyTo.messageType in ['text', 'file', 'image', 'audio', 'call']
          )
        )
        && validChatAttachment()
        && request.resource.data.createdAt == request.time;
    }

    function validChatMessageParticipantUpdate(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
        && resource.data.senderUid == request.auth.uid
        && !resource.data.keys().hasAny(['deletedAt'])
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt'])
            && (
              !resource.data.keys().hasAny(['messageType'])
              || resource.data.messageType == 'text'
            )
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 1
            && request.resource.data.body.size() <= 2000
            && request.resource.data.editedAt == request.time
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'body',
              'deletedAt',
              'deletedByUid',
              'attachment'
            ])
            && request.resource.data.body == 'Mensaje eliminado'
            && request.resource.data.deletedByUid == request.auth.uid
            && request.resource.data.deletedAt == request.time
            && (
              !resource.data.keys().hasAny(['attachment'])
              || request.resource.data.attachment == null
            )
          )
        );
    }

    function validChatReactionCreate(chatId, reactionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
        && request.resource.data.keys().hasOnly([
          'uid',
          'messageId',
          'emoji',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.messageId is string
        && request.resource.data.messageId.size() >= 1
        && request.resource.data.messageId.size() <= 180
        && reactionId == request.resource.data.messageId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/chats/$(chatId)/mensajes/$(request.resource.data.messageId))
        && request.resource.data.emoji in ['👍', '❤️', '😂', '😮', '😢', '🙏']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validChatReactionUpdate(chatId, reactionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
        && resource.data.uid == request.auth.uid
        && reactionId == resource.data.messageId + '_' + request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji', 'updatedAt'])
        && request.resource.data.emoji in ['👍', '❤️', '😂', '😮', '😢', '🙏']
        && request.resource.data.updatedAt == request.time;
    }

    function validNotificationTokenWrite() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'userUid',
          'role',
          'token',
          'platform',
          'active',
          'permission',
          'origin',
          'userAgent',
          'deactivatedAt',
          'deactivationReason',
          'lastSeenAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform in ['web']
        && request.resource.data.active is bool
        && optionalString('role', 40)
        && optionalString('permission', 40)
        && optionalString('origin', 300)
        && optionalString('userAgent', 600)
        && optionalString('deactivationReason', 120);
    }

    function validChatNotificationCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'userUid',
          'usuario_id',
          'title',
          'titulo',
          'body',
          'cuerpo',
          'type',
          'category',
          'priority',
          'channels',
          'payload',
          'actionUrl',
          'role',
          'readAt',
          'leida',
          'fromRole',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userUid == request.resource.data.usuario_id
        && request.resource.data.type == 'chat_message'
        && request.resource.data.category == 'chat'
        && request.resource.data.priority in ['normal', 'high', 'critical']
        && request.resource.data.channels is list
        && request.resource.data.payload is map
        && request.resource.data.payload.keys().hasOnly(['type', 'chatId', 'messageId', 'assignmentId', 'url'])
        && request.resource.data.payload.type == 'chat_message'
        && request.resource.data.payload.chatId is string
        && request.resource.data.payload.messageId is string
        && validInternalUrl(request.resource.data.actionUrl)
        && (
          !request.resource.data.payload.keys().hasAny(['url'])
          || validInternalUrl(request.resource.data.payload.url)
        )
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.payload.chatId))
        && isChatParticipant(get(/databases/$(database)/documents/chats/$(request.resource.data.payload.chatId)).data)
        && (
          isChatParticipantUid(get(/databases/$(database)/documents/chats/$(request.resource.data.payload.chatId)).data, request.resource.data.userUid)
          || (
            hasUserProfile(request.resource.data.userUid)
            && get(userDoc(request.resource.data.userUid)).data.role == 'admin'
          )
        )
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1200
        && request.resource.data.readAt == null
        && request.resource.data.leida == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
