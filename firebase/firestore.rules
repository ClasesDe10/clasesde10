          'active',
          'schedulingStatus',
          'assignmentIntroSentAt',
          'createdAt',
          'updatedAt',
          'lastMessage',
          'lastMessageAt'
        ])
        && request.resource.data.assignmentId == chatId
        && request.resource.data.asignacion_id == chatId
        && (
          request.resource.data.familyUid == get(/databases/$(database)/documents/asignaciones/$(chatId)).data.familyUid
          || request.resource.data.familyUid == get(/databases/$(database)/documents/asignaciones/$(chatId)).data.familia_id
        )
        && (
          request.resource.data.teacherUid == get(/databases/$(database)/documents/asignaciones/$(chatId)).data.teacherUid
          || request.resource.data.teacherUid == get(/databases/$(database)/documents/asignaciones/$(chatId)).data.profesor_id
        )
        && request.resource.data.participantUids[request.resource.data.familyUid] == true
        && request.resource.data.participantUids[request.resource.data.teacherUid] == true
        && request.resource.data.active == true
        && (
          !request.resource.data.keys().hasAny(['assignmentIntroSentAt'])
          || request.resource.data.assignmentIntroSentAt == request.time
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (isAdmin() || isChatParticipant(request.resource.data));
    }

    function canReadChatPreference(chatId, userUid) {
      return signedIn()
        && userUid == request.auth.uid
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);
    }

    function validChatPreferenceCreate(chatId, userUid) {
      return canReadChatPreference(chatId, userUid)
        && request.resource.data.keys().hasOnly([
          'displayNameOverride',
          'createdAt',
          'updatedAt'
        ])
        && optionalString('displayNameOverride', 120)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validChatPreferenceUpdate(chatId, userUid) {
      return canReadChatPreference(chatId, userUid)
        && request.resource.data.keys().hasOnly([
          'displayNameOverride',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayNameOverride',
          'updatedAt'
        ])
        && optionalString('displayNameOverride', 120)
        && (
          !resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == resource.data.createdAt
        )
        && request.resource.data.updatedAt == request.time;
    }

    function validClassScheduleProposalCreate(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
        && request.resource.data.keys().hasOnly([
          'assignmentId',
          'familyUid',
          'teacherUid',
          'studentId',
          'materia',
          'fecha',
          'hora_inicio',
          'hora_fin',
