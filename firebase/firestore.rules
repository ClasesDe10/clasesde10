        && request.resource.data.status == 'cancelada'
        && request.resource.data.lifecycleStatus == 'cancelada'
        && request.resource.data.attendanceStatus == 'incidencia'
        && request.resource.data.incidentStatus == 'abierta'
        && request.resource.data.cancelledByUid == request.auth.uid
        && request.resource.data.cancelledByRole in ['familia', 'profesor']
        && (
          (request.resource.data.cancelledByRole == 'familia' && hasRole('familia'))
          || (request.resource.data.cancelledByRole == 'profesor' && hasRole('profesor'))
