rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserProfile(uid) {
      return exists(userDoc(uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return signedIn()
        && hasUserProfile(request.auth.uid)
        && get(userDoc(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function validPublicLead() {
      return request.resource.data.keys().hasOnly([
          'tipo',
          'nombre',
          'email',
          'telefono',
          'perfil',
          'asunto',
          'mensaje',
          'metadata',
          'estado',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'tipo',
          'nombre',
          'email',
          'metadata',
          'estado',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.tipo in ['contacto', 'familia', 'profesor']
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 160
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && (!request.resource.data.keys().hasAny(['telefono'])
          || request.resource.data.telefono == null
          || (request.resource.data.telefono is string && request.resource.data.telefono.size() <= 40))
        && (!request.resource.data.keys().hasAny(['perfil'])
          || request.resource.data.perfil == null
          || (request.resource.data.perfil is string && request.resource.data.perfil.size() <= 80))
        && (!request.resource.data.keys().hasAny(['asunto'])
          || request.resource.data.asunto == null
          || (request.resource.data.asunto is string && request.resource.data.asunto.size() <= 180))
        && (!request.resource.data.keys().hasAny(['mensaje'])
          || request.resource.data.mensaje == null
          || (request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 3000))
        && validPublicLeadMetadata();
    }

    function optionalMetadataString(field, maxSize) {
      return !request.resource.data.metadata.keys().hasAny([field])
        || request.resource.data.metadata[field] == null
        || (
          request.resource.data.metadata[field] is string
          && request.resource.data.metadata[field].size() <= maxSize
        );
    }

    function requiredString(field, minSize, maxSize) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= minSize
        && request.resource.data[field].size() <= maxSize;
    }

    function optionalString(field, maxSize) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] == null
        || (
          request.resource.data[field] is string
          && request.resource.data[field].size() <= maxSize
        );
    }

    function validClientTimestampsOnCreate() {
      return request.resource.data.createdAt == request.time
        && (
          !request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time
        );
    }

    function validClientUpdatedAt() {
      return request.resource.data.updatedAt == request.time;
    }

    function validPublicLeadMetadata() {
      return request.resource.data.metadata is map
          && request.resource.data.metadata.keys().hasOnly([
            'alumno',
            'anios',
            'canal',
            'consent_privacy',
            'disponibilidad',
            'frecuencia',
            'inicio',
            'materia',
            'materias',
            'modalidad',
            'nivel',
            'niveles',
            'objetivo',
            'origen',
            'page_path',
            'page_url',
            'presupuesto',
            'referrer',
            'user_agent',
            'utm_campaign',
            'utm_content',
            'utm_medium',
            'utm_source',
            'utm_term',
            'verificacion',
            'zona'
          ])
          && request.resource.data.metadata.keys().hasAll(['consent_privacy'])
          && optionalMetadataString('alumno', 160)
          && optionalMetadataString('anios', 80)
          && optionalMetadataString('canal', 80)
          && optionalMetadataString('disponibilidad', 300)
          && optionalMetadataString('frecuencia', 120)
          && optionalMetadataString('inicio', 120)
          && optionalMetadataString('materia', 180)
          && optionalMetadataString('materias', 180)
          && optionalMetadataString('modalidad', 120)
          && optionalMetadataString('nivel', 120)
          && optionalMetadataString('niveles', 120)
          && optionalMetadataString('objetivo', 160)
          && optionalMetadataString('origen', 80)
          && optionalMetadataString('page_path', 300)
          && optionalMetadataString('page_url', 500)
          && optionalMetadataString('presupuesto', 120)
          && optionalMetadataString('referrer', 500)
          && optionalMetadataString('user_agent', 500)
          && optionalMetadataString('utm_campaign', 160)
          && optionalMetadataString('utm_content', 160)
          && optionalMetadataString('utm_medium', 160)
          && optionalMetadataString('utm_source', 160)
          && optionalMetadataString('utm_term', 160)
          && optionalMetadataString('verificacion', 180)
          && optionalMetadataString('zona', 180)
          && request.resource.data.metadata.consent_privacy == true;
    }

    function validUserCreate(uid) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'email',
          'nombre',
          'apellidos',
          'telefono',
          'role',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['email', 'nombre', 'role', 'active', 'createdAt'])
        && request.resource.data.role in ['familia', 'profesor', 'alumno']
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        && requiredString('email', 3, 254)
        && requiredString('nombre', 1, 80)
        && optionalString('apellidos', 120)
        && optionalString('telefono', 40)
        && validClientTimestampsOnCreate();
    }

    function validUserSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'apellidos',
          'telefono',
          'updatedAt'
        ])
        && requiredString('nombre', 1, 80)
        && optionalString('apellidos', 120)
        && optionalString('telefono', 40)
        && validClientUpdatedAt()
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active;
    }

    function validRoleProfileCreate(uid, role) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'userUid',
          'email',
          'nombre',
          'apellidos',
          'telefono',
          'active',
          'status',
          'perfil_completo',
          'profileComplete',
          'estado_verificacion',
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'userUid',
          'email',
          'nombre',
          'active',
          'status',
          'createdAt'
        ])
        && request.resource.data.userUid == uid
        && request.resource.data.email == request.auth.token.email
        && requiredString('email', 3, 254)
        && requiredString('nombre', 1, 80)
        && optionalString('apellidos', 120)
        && optionalString('telefono', 40)
        && request.resource.data.active is bool
        && request.resource.data.status in (
          role == 'profesor'
            ? ['pendiente_revision', 'pendiente_perfil']
            : ['activo']
        )
        && (!request.resource.data.keys().hasAny(['perfil_completo'])
          || request.resource.data.perfil_completo == false)
        && (!request.resource.data.keys().hasAny(['profileComplete'])
          || request.resource.data.profileComplete == false)
        && (!request.resource.data.keys().hasAny(['estado_verificacion'])
          || request.resource.data.estado_verificacion in ['pendiente', 'pendiente_perfil'])
        && (!request.resource.data.keys().hasAny(['verificationStatus'])
          || request.resource.data.verificationStatus in ['pendiente', 'pendiente_perfil'])
        && validClientTimestampsOnCreate();
    }

    function validRoleProfileSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'apellidos',
          'telefono',
          'userUid',
          'email',
          'direccion',
          'address',
          'ciudad',
          'city',
          'codigo_postal',
          'postalCode',
          'zona',
          'zone',
          'contacto_preferido',
          'preferredContact',
          'contacto_emergencia_nombre',
          'emergencyContactName',
          'contacto_emergencia_telefono',
          'emergencyContactPhone',
          'idiomas',
          'languages',
          'notas_perfil',
          'profileNotes',
          'perfil_completo',
          'profileComplete',
          'profileCompletionPercent',
          'profileCompletion',
          'profileIssues',
          'trustScore',
          'trustLevel',
          'updatedAt',
          'updated_at'
        ])
        && requiredString('nombre', 1, 80)
        && optionalString('apellidos', 120)
        && optionalString('telefono', 40)
        && optionalString('direccion', 240)
        && optionalString('address', 240)
        && optionalString('ciudad', 160)
        && optionalString('city', 160)
        && optionalString('codigo_postal', 20)
        && optionalString('postalCode', 20)
        && optionalString('zona', 160)
        && optionalString('zone', 160)
        && optionalString('contacto_preferido', 40)
        && optionalString('preferredContact', 40)
        && optionalString('contacto_emergencia_nombre', 160)
        && optionalString('emergencyContactName', 160)
        && optionalString('contacto_emergencia_telefono', 40)
        && optionalString('emergencyContactPhone', 40)
        && optionalString('notas_perfil', 1200)
        && optionalString('profileNotes', 1200)
        && validClientUpdatedAt()
        && (
          request.resource.data.userUid == resource.data.userUid
          || (
            !resource.data.keys().hasAny(['userUid'])
            && request.resource.data.userUid == request.auth.uid
          )
        )
        && (
          request.resource.data.email == resource.data.email
          || (
            !resource.data.keys().hasAny(['email'])
            && request.resource.data.email == request.auth.token.email
          )
        )
        && request.resource.data.active == resource.data.active
        && request.resource.data.status == resource.data.status;
    }

    function validTeacherProfileSelfUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'nombre',
          'apellidos',
          'telefono',
          'foto_url',
          'photoUrl',
          'direccion',
          'address',
          'ciudad',
          'city',
          'codigo_postal',
          'postalCode',
          'zona',
          'zone',
          'nivel_estudios',
          'studyLevel',
          'estudio_exacto',
          'exactStudy',
          'centro_estudios',
          'studyCenter',
          'colegio_estudios',
          'nota_bachillerato',
          'bachilleratoGrade',
          'nota_media_universidad',
          'universityAverageGrade',
          'bio',
          'experiencia_anios',
          'experienceYears',
          'disponibilidad_resumen',
          'availabilitySummary',
          'materias',
          'subjects',
          'niveles_educativos',
          'levels',
          'especialidades',
          'specialties',
          'idiomas',
          'languages',
          'certificaciones',
          'certifications',
          'acepta_bizum',
          'hasBizum',
          'perfil_completo',
          'profileComplete',
          'profileCompletionPercent',
          'profileCompletion',
          'profileIssues',
          'trustScore',
          'trustLevel',
          'estado_verificacion',
          'verificationStatus',
          'status',
          'updatedAt',
          'updated_at'
        ])
        && (
          request.resource.data.userUid == resource.data.userUid
          || (
            !resource.data.keys().hasAny(['userUid'])
            && request.resource.data.userUid == request.auth.uid
          )
        )
        && request.resource.data.email == resource.data.email
        && request.resource.data.active == resource.data.active
        && (!changed.hasAny(['estado_verificacion'])
          || request.resource.data.estado_verificacion in ['pendiente', 'pendiente_perfil'])
        && (!changed.hasAny(['verificationStatus'])
          || request.resource.data.verificationStatus in ['pendiente', 'pendiente_perfil'])
        && (!changed.hasAny(['status'])
          || request.resource.data.status in ['pendiente_revision', 'pendiente_perfil'])
        && validClientUpdatedAt();
    }

    function validFamilyStudentUpdate() {
      return isFamilyParticipant(resource.data)
        && request.resource.data.familyUid == resource.data.familyUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'apellidos',
          'curso',
          'nivel',
          'nivel_educativo',
          'colegio',
          'fecha_nacimiento',
          'materias',
          'materias_necesita',
          'objetivos',
          'disponibilidad',
          'activo',
          'active',
          'updatedAt',
          'updated_at'
        ]);
    }

    function validStudentSelfClaim() {
      return signedIn()
        && (!resource.data.keys().hasAny(['studentUid']) || resource.data.studentUid == null)
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentUid',
          'usuario_id',
          'updatedAt',
          'updated_at'
        ]);
    }

    function isFamilyParticipant(data) {
      return signedIn()
        && (
          data.familyUid == request.auth.uid
          || data.familia_id == request.auth.uid
          || (
            data.keys().hasAny(['studentId'])
            && exists(/databases/$(database)/documents/alumnos/$(data.studentId))
            && get(/databases/$(database)/documents/alumnos/$(data.studentId)).data.familyUid == request.auth.uid
          )
          || (
            data.keys().hasAny(['alumno_id'])
            && exists(/databases/$(database)/documents/alumnos/$(data.alumno_id))
            && get(/databases/$(database)/documents/alumnos/$(data.alumno_id)).data.familyUid == request.auth.uid
          )
        );
    }

    function isTeacherParticipant(data) {
      return signedIn()
        && (
          data.teacherUid == request.auth.uid
          || data.profesor_id == request.auth.uid
          || (data.keys().hasAny(['teacherUids']) && data.teacherUids[request.auth.uid] == true)
        );
    }

    function isStudentParticipant(data) {
      return signedIn() && data.studentUid == request.auth.uid;
    }

    function isParticipant(data) {
      return isFamilyParticipant(data)
        || isTeacherParticipant(data)
        || isStudentParticipant(data);
    }

    function validTeacherPayoutCreate() {
      return hasRole('profesor')
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.profesor_id == request.auth.uid
        && request.resource.data.paymentType == 'teacher_payout'
        && request.resource.data.tipo == 'pago_profesor'
        && request.resource.data.metodo == 'bizum'
        && request.resource.data.estado == 'solicitado'
        && request.resource.data.status == 'solicitado'
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 5000
        && request.resource.data.amount == request.resource.data.monto
        && request.resource.data.classIds is list
        && request.resource.data.classIds.size() > 0
        && request.resource.data.classIds.size() <= 40
        && request.resource.data.classCount == request.resource.data.classIds.size()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'tipo',
          'paymentType',
          'teacherUid',
          'profesor_id',
          'userUid',
          'requestedByUid',
          'monto',
          'amount',
          'metodo',
          'method',
          'gateway',
          'provider',
          'estado',
          'status',
          'concepto',
          'notas_profesor',
          'teacherNotes',
          'telefono_bizum',
          'classIds',
          'classCount',
          'reconciliationStatus',
          'verificationSource',
          'idempotencyKey',
          'dueAt',
          'due_at',
          'createdAt',
          'created_at',
          'updatedAt',
          'updated_at'
        ]);
    }

    function validFamilyPaymentCreate() {
      return hasRole('familia')
        && request.resource.data.familyUid == request.auth.uid
        && request.resource.data.familia_id == request.auth.uid
        && request.resource.data.paymentType == 'family_payment'
        && request.resource.data.tipo == 'pago_familia'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.status == 'pendiente'
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 10000
        && request.resource.data.amount == request.resource.data.monto
        && request.resource.data.metodo in ['bizum', 'transferencia', 'efectivo', 'card', 'stripe_bizum', 'redsys_bizum']
        && request.resource.data.method == request.resource.data.metodo
        && request.resource.data.gateway in ['manual', 'stripe', 'redsys', 'bank_import']
        && request.resource.data.provider == request.resource.data.gateway
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'tipo',
          'paymentType',
          'familia_id',
          'familyUid',
          'documento_id',
          'documentId',
          'monto',
          'amount',
          'metodo',
          'method',
          'gateway',
          'provider',
          'estado',
          'status',
          'referencia',
          'reference',
          'concepto',
          'notas_familia',
          'familyNotes',
          'classIds',
          'classCount',
          'reconciliationStatus',
          'verificationSource',
          'verified',
          'dueAt',
          'due_at',
          'idempotencyKey',
          'createdAt',
          'created_at',
          'updatedAt',
          'updated_at'
        ]);
    }

    function isChatParticipant(data) {
      return signedIn()
        && (
          data.familyUid == request.auth.uid
          || data.teacherUid == request.auth.uid
          || (
            data.keys().hasAny(['participantUids'])
            && data.participantUids[request.auth.uid] == true
          )
        );
    }

    function validTeacherClassUpdate() {
      return isTeacherParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'status',
          'lifecycleStatus',
          'teacherConfirmationStatus',
          'teacherAttendanceStatus',
          'attendanceStatus',
          'incidentStatus',
          'notasProfesor',
          'notas_profesor',
          'cancelacion_motivo',
          'reprogramacion_motivo',
          'teacherMarkedAt',
          'teacherMarkedByUid',
          'updatedAt',
          'updated_at'
        ])
        && request.resource.data.estado in ['realizada', 'cancelada', 'reprogramada']
        && (
          !request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status == request.resource.data.estado
        );
    }

    function validFamilyClassConfirmationUpdate() {
      return isFamilyParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'confirmacion_familia',
          'familyConfirmationStatus',
          'familyAttendanceStatus',
          'attendanceStatus',
          'incidentStatus',
          'familyConfirmedAt',
          'familyConfirmedByUid',
          'notas_familia',
          'familyNotes',
          'updatedAt',
          'updated_at'
        ])
        && request.resource.data.familyConfirmationStatus in ['realizada', 'no_realizada', 'incidencia']
        && request.resource.data.confirmacion_familia == request.resource.data.familyConfirmationStatus;
    }

    function validClassIncidentCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'classId',
          'clase_id',
          'familyUid',
          'familia_id',
          'teacherUid',
          'profesor_id',
          'studentId',
          'alumno_id',
          'tipo',
          'titulo',
          'descripcion',
          'estado',
          'status',
          'prioridad',
          'reportado_por',
          'createdByUid',
          'source',
          'createdAt',
          'created_at',
          'updatedAt',
          'updated_at'
        ])
        && request.resource.data.keys().hasAll(['classId', 'estado', 'titulo', 'descripcion', 'createdAt'])
        && exists(/databases/$(database)/documents/clases/$(request.resource.data.classId))
        && isParticipant(get(/databases/$(database)/documents/clases/$(request.resource.data.classId)).data)
        && request.resource.data.estado == 'abierta'
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status == 'abierta')
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time);
    }

    function validChatCreate(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/asignaciones/$(chatId))
        && request.resource.data.keys().hasOnly([
          'assignmentId',
          'asignacion_id',
          'familyUid',
          'familia_id',
          'teacherUid',
          'profesor_id',
          'studentId',
          'alumno_id',
          'materia',
          'familyName',
          'teacherName',
          'studentName',
          'participantUids',
          'active',
          'createdAt',
          'updatedAt',
          'lastMessage',
          'lastMessageAt'
        ])
        && request.resource.data.assignmentId == chatId
        && request.resource.data.asignacion_id == chatId
        && (
          request.resource.data.familyUid == get(/databases/$(database)/documents/asignaciones/$(chatId)).data.familyUid
          || request.resource.data.familyUid == get(/databases/$(database)/documents/asignaciones/$(chatId)).data.familia_id
        )
        && (
          request.resource.data.teacherUid == get(/databases/$(database)/documents/asignaciones/$(chatId)).data.teacherUid
          || request.resource.data.teacherUid == get(/databases/$(database)/documents/asignaciones/$(chatId)).data.profesor_id
        )
        && request.resource.data.participantUids[request.resource.data.familyUid] == true
        && request.resource.data.participantUids[request.resource.data.teacherUid] == true
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (isAdmin() || isChatParticipant(request.resource.data));
    }

    function validChatMessageCreate() {
      return request.resource.data.keys().hasOnly([
          'senderUid',
          'senderRole',
          'senderName',
          'body',
          'createdAt',
          'readBy'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole in ['familia', 'profesor', 'admin']
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.createdAt == request.time;
    }

    match /leadsPublicos/{leadId} {
      allow create: if validPublicLead();
      allow read, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow create: if validUserCreate(uid);
      allow read: if isAdmin() || isOwner(uid);
      allow update: if isAdmin() || (isOwner(uid) && validUserSelfUpdate());
      allow delete: if isAdmin();
    }

    match /profesores/{uid} {
      allow create: if isAdmin() || validRoleProfileCreate(uid, 'profesor');
      allow read: if isAdmin() || isOwner(uid);
      allow update: if isAdmin() || (isOwner(uid) && validTeacherProfileSelfUpdate());
      allow delete: if isAdmin();
    }

    match /familias/{uid} {
      allow create: if isAdmin() || validRoleProfileCreate(uid, 'familia');
      allow read: if isAdmin() || isOwner(uid);
      allow update: if isAdmin() || (isOwner(uid) && validRoleProfileSelfUpdate());
      allow delete: if isAdmin();
    }

    match /alumnos/{studentId} {
      allow create: if isAdmin()
        || (hasRole('familia') && request.resource.data.familyUid == request.auth.uid);
      allow read: if isAdmin() || isParticipant(resource.data);
      allow update: if isAdmin()
        || validFamilyStudentUpdate()
        || validStudentSelfClaim();
      allow delete: if isAdmin();
    }

    match /alumno_invitaciones/{invitationId} {
      allow create: if hasRole('familia')
        && request.resource.data.familyUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'pendiente'
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 32
        && invitationId == request.resource.data.token;
      allow get: if isAdmin()
        || (signedIn() && resource.data.familyUid == request.auth.uid)
        || (
          resource.data.status == 'pendiente'
          && invitationId == resource.data.token
        );
      allow list: if isAdmin()
        || (signedIn() && resource.data.familyUid == request.auth.uid);
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.status == 'pendiente'
          && request.resource.data.status == 'usada'
          && request.resource.data.usedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'estado',
            'usedByUid',
            'usedAt',
            'updatedAt'
          ])
        );
      allow delete: if isAdmin();
    }

    match /asignaciones/{assignmentId} {
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin() || isParticipant(resource.data);
    }

    match /solicitudes/{requestId} {
      allow create: if isAdmin()
        || (hasRole('familia') && request.resource.data.familyUid == request.auth.uid);
      allow read: if isAdmin()
        || isFamilyParticipant(resource.data)
        || (
          signedIn()
          && (
            resource.data.assignedTeacherUid == request.auth.uid
            || resource.data.profesor_asignado_id == request.auth.uid
          )
        );
      allow update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow create: if validChatCreate(chatId);
      allow read: if isAdmin() || isChatParticipant(resource.data);
      allow update: if isAdmin()
        || (
          isChatParticipant(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage',
            'lastMessageAt',
            'updatedAt'
          ])
        );
      allow delete: if isAdmin();

      match /mensajes/{messageId} {
        allow read: if isAdmin()
          || (
            signedIn()
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && (
            isAdmin()
            || isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          )
          && validChatMessageCreate();
        allow update, delete: if isAdmin();
      }
    }

    match /clases/{classId} {
      allow create, delete: if isAdmin();
      allow read: if isAdmin() || isParticipant(resource.data);
      allow update: if isAdmin()
        || validTeacherClassUpdate()
        || validFamilyClassConfirmationUpdate();
    }

    match /incidencias/{incidentId} {
      allow create: if isAdmin() || validClassIncidentCreate();
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.keys().hasAny(['classId'])
          && exists(/databases/$(database)/documents/clases/$(resource.data.classId))
          && isParticipant(get(/databases/$(database)/documents/clases/$(resource.data.classId)).data)
        );
      allow update, delete: if isAdmin();
    }

    match /pagos/{paymentId} {
      allow create: if validFamilyPaymentCreate() || validTeacherPayoutCreate();
      allow read: if isAdmin() || isFamilyParticipant(resource.data) || isTeacherParticipant(resource.data);
      allow update, delete: if isAdmin();
    }

    match /documentos/{documentId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /notificaciones/{notificationId} {
      allow create, delete: if isAdmin();
      allow read: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'updatedAt'])
        );
    }

    match /configuracion/{configId} {
      allow read, write: if isAdmin();
    }

    match /configuracionPublica/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /importAudits/{auditId} {
      allow read, write: if isAdmin();
    }

    match /legacyImports/{docId} {
      allow read, write: if isAdmin();
    }

    match /matchingRuns/{runId} {
      allow read, write: if isAdmin();
    }

    match /solicitudMatches/{matchId} {
      allow read, write: if isAdmin();
    }

    match /automationEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /resumenMensual/{summaryId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
