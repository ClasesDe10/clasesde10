        && request.resource.data.familyUid == chatFamilyUid(get(/databases/$(database)/documents/chats/$(chatId)).data)
        && (!request.resource.data.keys().hasAny(['familia_id']) || request.resource.data.familia_id == chatFamilyUid(get(/databases/$(database)/documents/chats/$(chatId)).data))
        && request.resource.data.teacherUid == chatTeacherUid(get(/databases/$(database)/documents/chats/$(chatId)).data)
        && (!request.resource.data.keys().hasAny(['profesor_id']) || request.resource.data.profesor_id == chatTeacherUid(get(/databases/$(database)/documents/chats/$(chatId)).data))
        && (!request.resource.data.keys().hasAny(['studentId']) || request.resource.data.studentId == chatStudentId(get(/databases/$(database)/documents/chats/$(chatId)).data))
        && (!request.resource.data.keys().hasAny(['alumno_id']) || request.resource.data.alumno_id == chatStudentId(get(/databases/$(database)/documents/chats/$(chatId)).data))
        && request.resource.data.status == 'propuesta'
        && (!request.resource.data.keys().hasAny(['kind']) || request.resource.data.kind in ['weekly_recurring', 'one_off'])
        && (!request.resource.data.keys().hasAny(['scheduleKind']) || request.resource.data.scheduleKind == request.resource.data.kind)
        && (!request.resource.data.keys().hasAny(['firstClassDate']) || request.resource.data.firstClassDate == request.resource.data.fecha)
        && (!request.resource.data.keys().hasAny(['duracion_minutos']) || request.resource.data.duracion_minutos == request.resource.data.durationMinutes)
        && (!request.resource.data.keys().hasAny(['source']) || request.resource.data.source in ['classes_panel_one_off', 'chat_schedule_form'])
        && validScheduleRecurrence(request.resource.data)
        && request.resource.data.proposedByUid == request.auth.uid
        && request.resource.data.proposedByRole in ['familia', 'profesor', 'admin']
