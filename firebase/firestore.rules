        && request.resource.data.responsibilityPenalty.appliedToUid == request.auth.uid
        && request.resource.data.responsibilityPenalty.appliedToRole == request.resource.data.cancelledByRole
        && request.resource.data.responsibilityPenalty.reason == 'calendar_cancellation'
        && request.resource.data.trustScoreDelta == -3
        && request.resource.data.trustPenaltyReason == 'calendar_cancellation'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.canceledAt == request.time
        && request.resource.data.updatedAt == request.time;
