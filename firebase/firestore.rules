        && request.resource.data.userUid == request.resource.data.usuario_id
        && request.resource.data.type == 'class_cancelled'
        && request.resource.data.category == 'calendar'
        && request.resource.data.priority in ['high', 'critical']
        && request.resource.data.channels is list
        && request.resource.data.payload is map
        && request.resource.data.payload.keys().hasOnly(['type', 'classId', 'assignmentId', 'url'])
        && request.resource.data.payload.type == 'class_cancelled'
        && request.resource.data.payload.classId is string
        && exists(classPath)
        && isParticipant(get(classPath).data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.userUid != request.auth.uid
        && (
          request.resource.data.userUid == get(classPath).data.familyUid
          || request.resource.data.userUid == get(classPath).data.familia_id
          || request.resource.data.userUid == get(classPath).data.teacherUid
          || request.resource.data.userUid == get(classPath).data.profesor_id
        )
        && validInternalUrl(request.resource.data.actionUrl)
        && validInternalUrl(request.resource.data.payload.url)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1200
        && request.resource.data.readAt == null
        && request.resource.data.leida == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validInternalUrl(value) {
      return value == null
        || (
          value is string
          && value.size() <= 500
          && value.matches('^/[A-Za-z0-9/_.,~#?&=%:+-]*$')
          && !value.matches('^//.*')
        );
    }

    function validDocumentType(value) {
      return value in [
        'dni',
        'identidad',
        'titulo',
        'notas_curso_anterior',
        'notas_universidad',
        'certificado',
        'certificado_idiomas',
        'certificado_formacion_especializada',
        'referencia_academica_profesional',
        'antecedentes',
        'contrato',
        'autorizacion',
        'factura',
        'recibo',
        'justificante',
        'justificante_pago',
        'curriculum',
        'interno',
        'otro'
      ];
    }

    function validOwnerDocumentStatus(value) {
      return value in ['pendiente', 'en_revision'];
    }

    function validOwnerDocumentStoragePath(value) {
      return value is string
        && value.size() >= 12
        && value.size() <= 600
        && value.matches('^users/[^/]+/documentos/.+')
        && !value.matches('.*\\.\\..*');
    }

    function validOwnerDocumentMime(value) {
      return value == null
        || (
          value is string
          && value.size() <= 180
          && value.matches('^(image/(jpeg|jpg|png|webp)|application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet|presentationml\\.presentation)|text/plain)$')
        );
    }

    function validOwnerDocumentSize(value) {
      return value == null
        || value is int
        || value is float;
    }

    function validDocumentBlobCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'storagePath',
          'name',
          'contentType',
          'sizeBytes',
          'dataBase64',
          'chunkCount',
          'chunkBase64Size',
          'totalBase64Size',
          'createdAt',
          'source'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid',
          'storagePath',
          'name',
          'contentType',
          'sizeBytes',
          'createdAt',
          'source'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^users/' + request.auth.uid + '/documentos/.+')
        && request.resource.data.storagePath.size() <= 600
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 240
        && validOwnerDocumentMime(request.resource.data.contentType)
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes <= 5 * 1024 * 1024
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 80
        && (
          (
            request.resource.data.source == 'firestore_fallback_no_storage_bucket'
            && request.resource.data.keys().hasAll(['dataBase64'])
            && !request.resource.data.keys().hasAny(['chunkCount', 'chunkBase64Size', 'totalBase64Size'])
            && request.resource.data.dataBase64 is string
            && request.resource.data.dataBase64.size() > 0
            && request.resource.data.dataBase64.size() <= 960 * 1024
          )
          || (
            request.resource.data.source == 'firestore_chunked_no_storage_bucket'
            && request.resource.data.keys().hasAll(['chunkCount', 'chunkBase64Size', 'totalBase64Size'])
            && !request.resource.data.keys().hasAny(['dataBase64'])
            && request.resource.data.chunkCount is int
            && request.resource.data.chunkCount > 1
            && request.resource.data.chunkCount <= 16
            && request.resource.data.chunkBase64Size is int
            && request.resource.data.chunkBase64Size > 0
            && request.resource.data.chunkBase64Size <= 780 * 1024
            && request.resource.data.totalBase64Size is int
            && request.resource.data.totalBase64Size > 960 * 1024
            && request.resource.data.totalBase64Size <= 8 * 1024 * 1024
          )
        );
    }

    function validDocumentBlobChunkCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'storagePath',
          'blobId',
          'index',
          'dataBase64',
          'createdAt',
          'source'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid',
          'storagePath',
          'blobId',
          'index',
          'dataBase64',
          'createdAt',
          'source'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^users/' + request.auth.uid + '/documentos/.+')
        && request.resource.data.storagePath.size() <= 600
        && request.resource.data.blobId is string
        && request.resource.data.blobId.matches('^firestore-document-fallback_[a-f0-9]{64}$')
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.index < 16
        && request.resource.data.dataBase64 is string
        && request.resource.data.dataBase64.size() > 0
        && request.resource.data.dataBase64.size() <= 780 * 1024
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 80
        && request.resource.data.source == 'firestore_chunked_no_storage_bucket';
    }

    function validOwnerDocumentBase(data) {
      return data.keys().hasOnly([
          'id',
          'ownerUid',
          'usuario_id',
          'userUid',
          'profileId',
          'role',
          'ownerRole',
          'documentType',
          'tipo',
          'typeLabel',
          'category',
          'name',
          'nombre',
          'status',
          'estado',
          'storedStatus',
          'rawStatus',
          'verificationStatus',
          'verificationLevel',
          'version',
          'versions',
          'history',
          'observations',
          'adminNotes',
          'storagePath',
          'storage_path',
          'url',
          'mimeType',
          'mime_type',
          'sizeBytes',
          'tamano_bytes',
          'uploadedAt',
          'createdAt',
          'created_at',
          'updatedAt',
          'updated_at',
          'expiresAt',
          'daysToExpiry',
          'expired',
          'expiresSoon',
          'requiresManualVerification',
          'sensitive',
          'publicSignal',
          'trustWeight',
          'permissions',
          'autoChecks',
          'automationFlags',
          'documentCenterVersion',
          'month',
          'partitionKey',
          'scaleShard'
        ])
        && data.keys().hasAll([
          'ownerUid',
          'usuario_id',
          'userUid',
          'role',
          'ownerRole',
          'documentType',
          'tipo',
          'name',
          'nombre',
          'status',
          'estado',
          'verificationStatus',
          'storagePath',
          'storage_path',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid == request.auth.uid
        && data.userUid == request.auth.uid
        && data.usuario_id == request.auth.uid
        && data.role in ['familia', 'profesor', 'alumno']
        && data.ownerRole == data.role
        && validDocumentType(data.documentType)
        && data.tipo == data.documentType
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 240
        && data.nombre == data.name
        && validOwnerDocumentStatus(data.status)
        && data.estado == data.status
        && data.verificationStatus == data.status
        && (!data.keys().hasAny(['storedStatus']) || data.storedStatus == data.status)
        && (!data.keys().hasAny(['rawStatus']) || data.rawStatus == data.status)
        && (!data.keys().hasAny(['verificationLevel']) || data.verificationLevel in ['sin_verificar', 'metadata_validada'])
        && validOwnerDocumentStoragePath(data.storagePath)
        && data.storage_path == data.storagePath
        && (!data.keys().hasAny(['url']) || data.url == data.storagePath)
        && validOwnerDocumentMime(data.mimeType)
        && validOwnerDocumentMime(data.mime_type)
        && validOwnerDocumentSize(data.sizeBytes)
        && validOwnerDocumentSize(data.tamano_bytes)
        && (!data.keys().hasAny(['sizeBytes']) || data.sizeBytes <= 10 * 1024 * 1024)
        && (!data.keys().hasAny(['tamano_bytes']) || data.tamano_bytes <= 10 * 1024 * 1024)
        && data.createdAt is string
        && data.createdAt.size() <= 80
        && data.updatedAt is string
        && data.updatedAt.size() <= 80
        && (!data.keys().hasAny(['created_at']) || data.created_at == data.createdAt)
        && (!data.keys().hasAny(['updated_at']) || data.updated_at == data.updatedAt)
        && (!data.keys().hasAny(['profileId']) || data.profileId is string)
        && (!data.keys().hasAny(['version']) || data.version is int || data.version is float)
        && (!data.keys().hasAny(['versions']) || data.versions is list)
        && (!data.keys().hasAny(['history']) || data.history is list)
        && (!data.keys().hasAny(['permissions']) || data.permissions is map)
        && (!data.keys().hasAny(['autoChecks']) || data.autoChecks is map)
        && (!data.keys().hasAny(['automationFlags']) || data.automationFlags is map)
        && !data.keys().hasAny([
          'verifiedAt',
          'verifiedByUid',
          'verifiedByEmail',
          'rejectedAt',
          'rejectedByUid',
          'notas_admin'
        ]);
    }

    function validOwnerDocumentCreate() {
      return signedIn()
        && validOwnerDocumentBase(request.resource.data);
    }

    function canOwnerDeleteDocument() {
      return signedIn()
        && resource.data.ownerUid == request.auth.uid
        && (!resource.data.keys().hasAny(['status']) || resource.data.status in ['pendiente', 'en_revision', 'rechazado', 'requiere_actualizacion']);
    }

    match /leadsPublicos/{leadId} {
      allow create: if validPublicLead();
      allow read: if isAdmin() || canReadOwnAssistedFamilyLead();
      allow update: if isAdmin() || validOwnAssistedFamilyLeadClaim();
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow create: if validUserCreate(uid);
      allow read: if isAdmin() || isOwner(uid);
      allow update: if isAdmin() || (isOwner(uid) && validUserSelfUpdate());
      allow delete: if isAdmin();
    }

    match /profesores/{uid} {
      allow create: if isAdmin() || validRoleProfileCreate(uid, 'profesor');
      allow read: if isAdmin() || isOwner(uid);
      allow update: if isAdmin() || (isOwner(uid) && validTeacherProfileSelfUpdate());
      allow delete: if isAdmin();
    }

    match /familias/{uid} {
      allow create: if isAdmin() || validRoleProfileCreate(uid, 'familia');
      allow read: if isAdmin() || isOwner(uid);
      allow update: if isAdmin() || (isOwner(uid) && validRoleProfileSelfUpdate());
      allow delete: if isAdmin();
    }

    match /alumnos/{studentId} {
      allow create: if isAdmin()
        || (hasRole('familia') && request.resource.data.familyUid == request.auth.uid);
      allow read: if isAdmin() || isParticipant(resource.data);
      allow update: if isAdmin()
        || validFamilyStudentUpdate()
        || validStudentSelfClaim();
      allow delete: if isAdmin();
    }

    match /alumno_invitaciones/{invitationId} {
      allow create: if hasRole('familia')
        && request.resource.data.familyUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'pendiente'
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 32
        && invitationId == request.resource.data.token;
      allow get: if isAdmin()
        || (signedIn() && resource.data.familyUid == request.auth.uid)
        || (
          resource.data.status == 'pendiente'
          && invitationId == resource.data.token
        );
      allow list: if isAdmin()
        || (signedIn() && resource.data.familyUid == request.auth.uid);
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.status == 'pendiente'
          && request.resource.data.status == 'usada'
          && request.resource.data.usedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'estado',
            'usedByUid',
            'usedAt',
            'updatedAt'
          ])
        );
      allow delete: if isAdmin();
    }

    match /disponibilidad/{availabilityId} {
      allow create: if isAdmin() || validAvailabilityCreate(request.resource.data);
      allow read: if canReadAvailability(resource.data);
      allow update: if isAdmin()
        || validAvailabilityUpdate();
      allow delete: if isAdmin()
        || isAvailabilityOwner(resource.data);
    }

    match /busySlots/{busySlotId} {
      allow create: if isAdmin() || validBusySlotCreate(request.resource.data);
      allow read: if canReadBusySlot(resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin() || validParticipantBusySlotDelete(resource.data);
    }

    match /asignaciones/{assignmentId} {
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin() || isParticipant(resource.data);
    }

    match /solicitudes/{requestId} {
      allow create: if isAdmin()
        || (hasRole('familia') && request.resource.data.familyUid == request.auth.uid);
      allow read: if isAdmin()
        || isFamilyParticipant(resource.data)
        || canReadOwnAssistedFamilyRequest()
        || (
          signedIn()
          && (
            resource.data.assignedTeacherUid == request.auth.uid
            || resource.data.profesor_asignado_id == request.auth.uid
          )
        );
      allow update: if isAdmin() || validOwnAssistedFamilyRequestClaim();
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow create: if isAdmin() || validChatCreate(chatId);
      allow read: if isAdmin() || isChatParticipant(resource.data);
      allow update: if isAdmin()
        || (
          isChatParticipant(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'lastMessage',
             'lastMessageAt',
             'lastMessageByUid',
             'lastMessageId',
             'lastMessageType',
             'unreadBy',
             'deliveredAtBy',
             'readAtBy',
             'schedulingStatus',
          'relationshipStage',
          'relationshipStatus',
          'activeClassId',
          'activeClassIds',
          'classSeriesId',
          'seriesEndDate',
          'lastRelationshipEvent',
          'relationshipUpdatedAt',
          'updatedAt'
           ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
            || (
              request.resource.data.lastMessage is string
              && request.resource.data.lastMessage.size() <= 180
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageAt'])
            || request.resource.data.lastMessageAt == request.time
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageByUid'])
            || request.resource.data.lastMessageByUid == request.auth.uid
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageId'])
            || (
              request.resource.data.lastMessageId is string
              && request.resource.data.lastMessageId.size() <= 180
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageType'])
            || request.resource.data.lastMessageType in ['text', 'file', 'image', 'audio', 'call']
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unreadBy'])
            || (
              request.resource.data.unreadBy is map
              && request.resource.data.unreadBy.size() <= 20
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveredAtBy'])
            || (
              request.resource.data.deliveredAtBy is map
              && request.resource.data.deliveredAtBy.size() <= 20
              && request.resource.data.deliveredAtBy[request.auth.uid] == request.time
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAtBy'])
            || (
              request.resource.data.readAtBy is map
              && request.resource.data.readAtBy.size() <= 20
              && request.resource.data.readAtBy[request.auth.uid] == request.time
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['schedulingStatus'])
            || request.resource.data.schedulingStatus in ['pendiente_horario', 'horario_propuesto', 'horario_rechazado', 'clase_programada', 'confirmed']
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['relationshipStage'])
            || request.resource.data.relationshipStage in ['pendiente_horario', 'horario_propuesto', 'clase_programada']
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['relationshipStatus'])
            || request.resource.data.relationshipStatus in ['active']
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeClassId'])
            || (
              request.resource.data.activeClassId is string
              && request.resource.data.activeClassId.size() <= 180
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeClassIds'])
            || request.resource.data.activeClassIds is list
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['classSeriesId'])
            || request.resource.data.classSeriesId == null
            || request.resource.data.classSeriesId is string
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seriesEndDate'])
            || request.resource.data.seriesEndDate is string
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastRelationshipEvent'])
            || request.resource.data.lastRelationshipEvent in [
              'schedule_proposed',
              'schedule_rejected',
              'class_scheduled_from_chat',
              'one_off_class_proposed_from_classes',
              'one_off_class_accepted_from_classes',
              'one_off_class_rejected_from_classes'
            ]
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['relationshipUpdatedAt'])
            || request.resource.data.relationshipUpdatedAt == request.time
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt == request.time
          )
        );
      allow delete: if isAdmin();

      match /mensajes/{messageId} {
        allow read: if isAdmin()
          || (
            signedIn()
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && (
            isAdmin()
            || isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          )
          && validChatMessageCreate();
        allow update: if isAdmin() || validChatMessageParticipantUpdate(chatId);
        allow delete: if isAdmin();
      }

      match /reacciones/{reactionId} {
        allow read: if isAdmin()
          || (
            signedIn()
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
        allow create: if isAdmin() || validChatReactionCreate(chatId, reactionId);
        allow update: if isAdmin() || validChatReactionUpdate(chatId, reactionId);
        allow delete: if isAdmin()
          || (
            signedIn()
            && resource.data.uid == request.auth.uid
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
      }

      match /typing/{typingUid} {
        allow read: if isAdmin()
          || (
            signedIn()
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
        allow create, update: if signedIn()
          && request.auth.uid == typingUid
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'isTyping', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 160
          && request.resource.data.isTyping is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == typingUid);
      }

      match /calls/{callId} {
        allow read: if isAdmin()
          || (
            signedIn()
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
        allow create, update: if signedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && (
            isAdmin()
            || isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
        allow delete: if isAdmin();

        match /offerCandidates/{candidateId} {
          allow read, create: if signedIn()
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && (
              isAdmin()
              || isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
            );
          allow update, delete: if isAdmin();
        }

        match /answerCandidates/{candidateId} {
          allow read, create: if signedIn()
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && (
              isAdmin()
              || isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
            );
          allow update, delete: if isAdmin();
        }

        match /audioStreams/{senderUid}/chunks/{chunkId} {
          allow read: if isAdmin()
            || (
              signedIn()
              && exists(/databases/$(database)/documents/chats/$(chatId))
              && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
            );
          allow create, update: if signedIn()
            && request.auth.uid == senderUid
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && (
              isAdmin()
              || isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
            )
            && request.resource.data.keys().hasOnly([
              'senderUid',
              'seq',
              'sampleRate',
              'codec',
              'audio',
              'createdAt'
            ])
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.seq is int
            && request.resource.data.seq >= 0
            && request.resource.data.sampleRate == 8000
            && request.resource.data.codec == 'mulaw'
            && request.resource.data.audio is string
            && request.resource.data.audio.size() <= 6000
            && request.resource.data.createdAt == request.time;
          allow delete: if isAdmin() || (signedIn() && request.auth.uid == senderUid);
        }
      }

      match /preferencias/{userUid} {
        allow read: if isAdmin() || canReadChatPreference(chatId, userUid);
        allow create: if validChatPreferenceCreate(chatId, userUid);
        allow update: if validChatPreferenceUpdate(chatId, userUid);
        allow delete: if canReadChatPreference(chatId, userUid);
      }

      match /programaciones/{proposalId} {
        allow read: if isAdmin()
          || (
            signedIn()
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
        allow create: if validClassScheduleProposalCreate(chatId);
        allow update: if validClassScheduleProposalUpdate(chatId);
        allow delete: if isAdmin();
      }
    }

    match /clases/{classId} {
      allow create: if isAdmin() || validParticipantClassCreate();
      allow delete: if isAdmin();
      allow read: if isAdmin() || isParticipant(resource.data);
      allow update: if isAdmin()
        || validTeacherClassUpdate()
        || validFamilyClassConfirmationUpdate()
        || validParticipantClassCancellationUpdate();
    }

    match /incidencias/{incidentId} {
      allow create: if isAdmin() || validClassIncidentCreate();
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.keys().hasAny(['classId'])
          && exists(/databases/$(database)/documents/clases/$(resource.data.classId))
          && isParticipant(get(/databases/$(database)/documents/clases/$(resource.data.classId)).data)
        );
      allow update, delete: if isAdmin();
    }

    match /pagos/{paymentId} {
      allow create: if validFamilyPaymentCreate() || validTeacherPayoutCreate();
      allow read: if isAdmin() || isFamilyParticipant(resource.data) || isTeacherParticipant(resource.data);
      allow update, delete: if isAdmin();
    }

    match /paymentSchedules/{scheduleId} {
      allow create: if isAdmin() || validPaymentScheduleCreate();
      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.ownerUid == request.auth.uid
            || resource.data.familyUid == request.auth.uid
            || resource.data.teacherUid == request.auth.uid
          )
        );
      allow update: if isAdmin() || validPaymentScheduleUpdate();
      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
        );
    }

    match /documentos/{documentId} {
      allow create: if isAdmin() || validOwnerDocumentCreate();
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || canOwnerDeleteDocument();
    }

    match /documentBlobs/{blobId} {
      allow create: if validDocumentBlobCreate();
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /documentBlobChunks/{chunkId} {
      allow create: if validDocumentBlobChunkCreate();
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /notificaciones/{notificationId} {
      allow create: if isAdmin() || validChatNotificationCreate() || validClassCancelledNotificationCreate();
      allow delete: if isAdmin();
      allow read: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'leida', 'updatedAt'])
        );
    }

    match /notificationTokens/{tokenId} {
      allow create: if validNotificationTokenWrite();
      allow update: if signedIn()
        && resource.data.userUid == request.auth.uid
        && validNotificationTokenWrite();
      allow read, delete: if isAdmin()
        || (signedIn() && resource.data.userUid == request.auth.uid);
    }

    match /notificationPreferences/{userUid} {
      allow read, write: if isAdmin() || isOwner(userUid);
    }

    match /configuracion/{configId} {
      allow read, write: if isAdmin();
    }

    match /configuracionPublica/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platformConfigHistory/{historyId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || validAuditLogCreate();
      allow update, delete: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow create: if validAnalyticsEventCreate();
      allow read, update, delete: if isAdmin();
    }

    match /analyticsDailyRollups/{rollupId} {
      allow read, write: if isAdmin();
    }

    match /experiments/{experimentId} {
      allow read, write: if isAdmin();
    }

    match /experimentsPublic/{experimentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /crmNotes/{noteId} {
      allow read, write: if isAdmin();
    }

    match /crmTasks/{taskId} {
      allow read, write: if isAdmin();
    }

    match /preventiveRisks/{riskId} {
      allow read, write: if isAdmin();
    }

    match /preventiveRiskSnapshots/{snapshotId} {
      allow read, write: if isAdmin();
    }

    match /alertDecisions/{decisionId} {
      allow read, write: if isAdmin();
    }

    match /alertPrioritySnapshots/{snapshotId} {
      allow read, write: if isAdmin();
    }

    match /adminAiQueries/{queryId} {
      allow read, write: if isAdmin();
    }

    match /internalAiInsights/{insightId} {
      allow read, write: if isAdmin();
    }

    match /internalAiInsightSnapshots/{snapshotId} {
      allow read, write: if isAdmin();
    }

    match /classLifecycleEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /importAudits/{auditId} {
      allow read, write: if isAdmin();
    }

    match /legacyImports/{docId} {
      allow read, write: if isAdmin();
    }

    match /matchingRuns/{runId} {
      allow read, write: if isAdmin();
    }

    match /solicitudMatches/{matchId} {
      allow read, write: if isAdmin();
    }

    match /automationEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /automationRules/{ruleId} {
      allow read, write: if isAdmin();
    }

    match /automationRuleRuns/{runId} {
      allow read, write: if isAdmin();
    }

    match /systemJobs/{jobId} {
      allow read, write: if isAdmin();
    }

    match /deadLetters/{deadLetterId} {
      allow read, write: if isAdmin();
    }

    match /metricSnapshots/{snapshotId} {
      allow read, write: if isAdmin();
    }

    match /opsAlerts/{alertId} {
      allow read, write: if isAdmin();
    }

    match /platformHealthChecks/{checkId} {
      allow read, write: if isAdmin();
    }

    match /platformSupervisionFindings/{findingId} {
      allow read, write: if isAdmin();
    }

    match /platformSupervisionSnapshots/{snapshotId} {
      allow read, write: if isAdmin();
    }

    match /relationshipFollowups/{followupId} {
      allow read, write: if isAdmin();
    }

    match /relationshipFollowupSnapshots/{snapshotId} {
      allow read, write: if isAdmin();
    }

    match /proactiveAssistSignals/{signalId} {
      allow read, write: if isAdmin();
    }

    match /proactiveAssistSnapshots/{snapshotId} {
      allow read, write: if isAdmin();
    }

    match /resumenMensual/{summaryId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
